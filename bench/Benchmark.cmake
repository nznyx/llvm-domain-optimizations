set(BENCH_OPT_LEVEL "3" CACHE STRING "Optimization level")
set(BENCH_PASS "none" CACHE STRING "Comma-separated passes: error,x86-layout")
option(BENCH_LTO "Use Full LTO with LLD" OFF)
option(BENCH_USE_PLUGIN "Load ErrorHeuristic (legacy switch)" OFF)
set(BENCH_CXX_FLAGS "" CACHE STRING "Extra benchmark compile flags")
set(BENCH_LINK_FLAGS "" CACHE STRING "Extra benchmark link flags")

# Additional arguments are parser translation units. Keep the timing harness out
# of the IR heuristic; x86 layout runs on the final linked module.
function(configure_benchmark target)
  if(NOT BENCH_OPT_LEVEL MATCHES "^(0|1|2|3|s|z)$")
    message(FATAL_ERROR "Unknown BENCH_OPT_LEVEL: ${BENCH_OPT_LEVEL}")
  endif()
  set(pass "${BENCH_PASS}")
  if(BENCH_USE_PLUGIN AND pass STREQUAL "none")
    set(pass error)
  endif()
  string(REPLACE "," ";" passes "${pass}")
  foreach(name IN LISTS passes)
    if(NOT name MATCHES "^(none|error|x86-layout)$")
      message(FATAL_ERROR "Unknown pass: ${name}")
    endif()
  endforeach()
  if(NOT pass STREQUAL "none" OR BENCH_LTO)
    foreach(lang C CXX)
      if(NOT CMAKE_${lang}_COMPILER_ID STREQUAL "Clang" OR
         NOT CMAKE_${lang}_COMPILER_VERSION MATCHES "^${LLVM_VERSION_MAJOR}[.]")
        message(FATAL_ERROR "Select clang and clang++ from LLVM ${LLVM_VERSION_MAJOR}")
      endif()
    endforeach()
  endif()

  separate_arguments(compile_flags NATIVE_COMMAND "${BENCH_CXX_FLAGS}")
  separate_arguments(link_flags NATIVE_COMMAND "${BENCH_LINK_FLAGS}")
  target_compile_features(${target} PRIVATE cxx_std_20)
  target_compile_options(${target} PRIVATE -O${BENCH_OPT_LEVEL} -g ${compile_flags})
  target_link_options(${target} PRIVATE ${link_flags})
  set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}")

  if("x86-layout" IN_LIST passes)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR
       NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64)$" OR NOT BENCH_OPT_LEVEL STREQUAL "3")
      message(FATAL_ERROR "x86-layout requires Linux x86-64 and -O3")
    endif()
    set(BENCH_LTO ON)
    add_dependencies(${target} X86LayoutPolicy)
    target_link_options(${target} PRIVATE -Xlinker "--load-pass-plugin=$<TARGET_FILE:X86LayoutPolicy>")
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "$<TARGET_FILE:X86LayoutPolicy>")
  endif()
  if("error" IN_LIST passes)
    add_dependencies(${target} ErrorHeuristic)
    set_property(SOURCE ${ARGN} APPEND PROPERTY COMPILE_OPTIONS "-fpass-plugin=$<TARGET_FILE:ErrorHeuristic>")
    set(stamp "${CMAKE_CURRENT_BINARY_DIR}/${target}-plugin.stamp")
    add_custom_command(OUTPUT "${stamp}"
      COMMAND "${CMAKE_COMMAND}" -E touch "${stamp}"
      DEPENDS ErrorHeuristic VERBATIM)
    add_custom_target(${target}-plugin-stamp DEPENDS "${stamp}")
    add_dependencies(${target} ${target}-plugin-stamp)
    set_property(SOURCE ${ARGN} APPEND PROPERTY OBJECT_DEPENDS "${stamp}")
  endif()

  if(BENCH_PROFILE)
    target_compile_options(${target} PRIVATE "-fprofile-use=${BENCH_PROFILE}"
      -Werror=profile-instr-out-of-date -Werror=profile-instr-unprofiled)
    target_link_options(${target} PRIVATE "-fprofile-use=${BENCH_PROFILE}")
    get_target_property(sources ${target} SOURCES)
    set_property(SOURCE ${sources} APPEND PROPERTY OBJECT_DEPENDS "${BENCH_PROFILE}")
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${BENCH_PROFILE}")
  endif()

  if(BENCH_LTO)
    find_program(LLD_EXECUTABLE NAMES ld.lld-${LLVM_VERSION_MAJOR} ld.lld HINTS "${LLVM_TOOLS_BINARY_DIR}" REQUIRED)
    execute_process(COMMAND "${LLD_EXECUTABLE}" --version OUTPUT_VARIABLE lld_version COMMAND_ERROR_IS_FATAL ANY)
    if(NOT lld_version MATCHES "LLD ${LLVM_VERSION_MAJOR}[.]")
      message(FATAL_ERROR "Full LTO needs LLD ${LLVM_VERSION_MAJOR}; selected ${lld_version}")
    endif()
    target_compile_options(${target} PRIVATE -flto=full)
    set(lto_level "${BENCH_OPT_LEVEL}")
    if(lto_level MATCHES "^[sz]$")
      set(lto_level 2)
    endif()
    target_link_options(${target} PRIVATE "--ld-path=${LLD_EXECUTABLE}" -flto=full "LINKER:--lto-O${lto_level}")
  endif()
endfunction()

# Keep the same three input names for every benchmark and every build mode.
function(bench_inputs train a b)
  foreach(input train a b)
    configure_file("${${input}}" "${PROJECT_BINARY_DIR}/inputs/${input}" COPYONLY)
  endforeach()
endfunction()
